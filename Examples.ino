// ============================================================================
// Examples.ino — คู่มือและตัวอย่างการใช้งานคำสั่งชุดใหม่ (FC-Only + FF/BB Time +
//                Velocity PID+FF + PoseEKF + Pure Pursuit PathControl)
// (ฟังก์ชันนี้ไม่ได้ถูกเรียกทำงานจริง ใช้สำหรับดูตัวอย่างและตรวจสอบคอมไพล์ทุก Overload)
// ============================================================================

void examples() {
    // ------------------------------------------------------------------------
    // 1. FC / BC / FC4 / BC4 (มาตรฐาน FC-Only พร้อมรองรับ 'L','R','l','r' และ TT)
    // ------------------------------------------------------------------------
    FC(60, 30.0f);                      // เดินหน้า 30 cm แล้วหยุด
    FC(60, 30.0f, false);               // เดินหน้า 30 cm ไม่หยุด
    FC(60, 30.0f, 5, 5);                // กำหนดระยะ Ramp Up / Ramp Down เอง
    FC(80, 30.0f, 'R');                 // เดินหน้า 30 cm -> TrunDegreeFront(90)
    FC(80, 30.0f, 'L');                 // เดินหน้า 30 cm -> TrunDegreeFront(-90)
    FC(80, 30.0f, 'r');                 // เดินหน้า 30 cm -> หยุดแล้ว SpinDegree(90)
    FC(80, 30.0f, 'l');                 // เดินหน้า 30 cm -> หยุดแล้ว SpinDegree(-90)
    FC(80, 30.0f, 'R', true);           // เดินหน้า 30 cm -> หยุดก่อนหมุน 90°
    FC(100, 30.0f, 'TR');               // เดินหน้า 30 cm -> TTF90(100, 15, 40)
    FC(100, 30.0f, "TL");               // เดินหน้า 30 cm -> TTF90(15, 100, 40)
    FC(100, 30.0f, "Tr", true);         // เดินหน้า 30 cm -> หยุดก่อน TTF45
    FC(100, 30.0f, 'R', 5, 5);
    FC(100, 30.0f, "TL", 5, 5);

    BC(50, 30.0f);                      // ถอยหลัง 30 cm แล้วหยุด
    BC(50, 30.0f, false);
    BC(50, 30.0f, 5, 5);
    BC(60, 30.0f, 'L');                 // ถอยหลัง 30 cm -> TrunDegreeBack(-90)
    BC(60, 30.0f, 'l');                 // ถอยหลัง 30 cm -> หยุดแล้ว SpinDegree(-90)
    BC(60, 30.0f, 'R', true);
    BC(100, 30.0f, 'TR');               // ถอยหลัง 30 cm -> TTB90(100, 15, 40)
    BC(100, 30.0f, "TL");
    BC(100, 30.0f, "Tl", true);
    BC(100, 30.0f, 'L', 5, 5);
    BC(100, 30.0f, "TR", 5, 5);

    FC4(60, 30.0f, 'R');                // เดินหน้า 30 cm -> Swing ขวา 45°
    FC4(60, 30.0f, 'l', true);          // เดินหน้า 30 cm -> หยุดแล้ว Spin ซ้าย 45°
    BC4(50, 20.0f, 'L');                // ถอยหลัง 20 cm -> Swing ซ้าย 45°
    BC4(50, 20.0f, 'r', true);          // ถอยหลัง 20 cm -> หยุดแล้ว Spin ขวา 45°

    // ------------------------------------------------------------------------
    // 2. คำสั่งเดินตามจำนวนช่องโดยตรง (FC_BOX / BC_BOX / BOX(n))
    // ------------------------------------------------------------------------
    FC_BOX(65, 1.0f);
    FC_BOX(65, 2.0f, false);
    FC_BOX(65, 2.0f, 'R');
    FC_BOX(65, 2.0f, 'r');
    FC_BOX(65, 2.0f, "TR");
    FC_BOX(65, 2.0f, 'L', true);
    FC_BOX(65, 2.0f, "TL", true);

    BC_BOX(50, 1.0f);
    BC_BOX(50, 2.0f, false);
    BC_BOX(50, 2.0f, 'L');
    BC_BOX(50, 2.0f, 'l');
    BC_BOX(50, 2.0f, "TL");
    BC_BOX(50, 2.0f, 'R', true);
    BC_BOX(50, 2.0f, "TR", true);
    FC(65, BOX(3));
    BC(50, BOX(2));

    // ------------------------------------------------------------------------
    // 3. ตีโค้ง Encoder ล้วน (TTF90 / TTF45 / TTB90 / TTB45) และ Gyro Spin/Turn
    // ------------------------------------------------------------------------
    TTF90(100, 15, 40);
    TTF45(80, 15, 30);
    TTB90(100, 15, 40);
    TTB45(80, 15, 30);

    SpinDegree(90.0f);
    SpinDegree(-90.0f);
    TrunDegreeFront(90.0f);
    TrunDegreeBack(-90.0f);

    // ------------------------------------------------------------------------
    // 4. คำสั่งเดินแบบจับเวลา (Time Move: FF / BB)
    // ------------------------------------------------------------------------
    FF(60, 400);
    FF(60, 500, 150, 200);
    BB(50, 400);
    BB(50, 500, 150, 200);

    // ------------------------------------------------------------------------
    // 5. จัดแนวเข้าเส้น (SetF / SetB), ปล่อยลูกบาศก์ (DropF / DropB) และ STOP
    // ------------------------------------------------------------------------
    SetF(25);
    SetF(25, 10.0f);
    SetF(25, 10.0f, 'R');
    SetB(25);
    SetB(25, 10.0f);
    SetB(25, 10.0f, 'L');

    DropF();
    DropF(30);
    DropB();
    DropB(30);

    // ------------------------------------------------------------------------
    // 6. Velocity PID+FF, PoseEKF และ Pure Pursuit (PathControl)
    // ------------------------------------------------------------------------
    driveWheelVelocitiesCmPs(40.0f, 40.0f);
    delay(200);
    driveStop();

    ekfReset(0.0f, 0.0f, 0.0f);
    ekfUpdate();
    float rx = ekfGetX();
    float ry = ekfGetY();
    float rh = ekfGetHeadingDeg();
    (void)rx; (void)ry; (void)rh;

    Waypoint curvePts[] = {
        {  0.0f,  0.0f },
        { 30.0f,  0.0f },
        { 60.0f, 30.0f },
        { 60.0f, 60.0f }
    };
    followPath(curvePts, 4, 50.0f, true);

    const float xs[] = { 60.0f, 30.0f, 0.0f };
    const float ys[] = { 60.0f, 30.0f, 0.0f };
    followWaypoints(xs, ys, 3, 45.0f, true, false, 15000UL);

    delay(500);
    STOP();
}
