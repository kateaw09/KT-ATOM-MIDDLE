// ============================================================================
// Examples.ino — คู่มือและตัวอย่างการใช้งานคำสั่งทั้งหมด (อยู่ใน void examples() เพื่อแสดงสีใน IDE)
// (ฟังก์ชันนี้ไม่ได้ถูกเรียกทำงานจริง ใช้สำหรับดูตัวอย่างและก๊อปปี้ไปใช้ใน RunMode1-3)
// ============================================================================

void examples() {
    // ------------------------------------------------------------------------
    // 1. คำสั่งเดินหน้า / ถอยหลังตามระยะทาง (เซนติเมตร)
    // ------------------------------------------------------------------------
    FC(60, 30);                 // เดินหน้าความเร็ว 60 ระยะ 30 ซม. แล้วหยุด
    BC(50, 30);                 // ถอยหลังความเร็ว 50 ระยะ 30 ซม. แล้วหยุด

    FC(60, 30, false);          // เดินหน้าแล้ว "ไม่หยุด" (เพื่อส่งต่อไปคำสั่งเลี้ยว/หมุนทันที)
    BC(50, 30, false);          // ถอยหลังแล้ว "ไม่หยุด"

    // ------------------------------------------------------------------------
    // 2. คำสั่งเดินพร้อมเลี้ยว 90 องศา (FC / BC)
    //    - ตัวใหญ่ ('L', 'R') = ไม่หยุดก่อนเลี้ยว -> Swing Turn 90° ต่อเนื่อง
    //    - ตัวเล็ก ('l', 'r') = หยุดก่อนเลี้ยว -> หมุนอยู่กับที่ Spin 90°
    //    - หากต้องการเลี้ยว 45° ให้ใช้ FC4 / BC4 แทน
    // ------------------------------------------------------------------------
    FC(60, 30, 'L');            // เดินหน้า 30 ซม. -> Swing หน้าซ้าย 90° (ไม่หยุด)
    FC(60, 30, 'R');            // เดินหน้า 30 ซม. -> Swing หน้าขวา 90° (ไม่หยุด)
    FC(60, 30, 'l');            // เดินหน้า 30 ซม. -> หยุดแล้วหมุน Spin ซ้าย 90°
    FC(60, 30, 'r');            // เดินหน้า 30 ซม. -> หยุดแล้วหมุน Spin ขวา 90°

    BC(50, 30, 'L');            // ถอยหลัง 30 ซม. -> Swing หลังซ้าย 90° (ไม่หยุด)
    BC(50, 30, 'R');            // ถอยหลัง 30 ซม. -> Swing หลังขวา 90° (ไม่หยุด)
    BC(50, 30, 'l');            // ถอยหลัง 30 ซม. -> หยุดแล้วหมุน Spin ซ้าย 90°
    BC(50, 30, 'r');            // ถอยหลัง 30 ซม. -> หยุดแล้วหมุน Spin ขวา 90°

    // ------------------------------------------------------------------------
    // 3. คำสั่งเดินพร้อมเลี้ยว 45 องศา (FC4 / BC4)
    //    - ตัวใหญ่ ('L', 'R') = ไม่หยุดก่อนเลี้ยว -> Swing Turn 45° ต่อเนื่อง
    //    - ตัวเล็ก ('l', 'r') = หยุดก่อนเลี้ยว -> หมุนอยู่กับที่ Spin 45°
    // ------------------------------------------------------------------------
    FC4(60, 30, 'L');           // เดินหน้า 30 ซม. -> Swing หน้าซ้าย 45° (ไม่หยุด)
    FC4(60, 30, 'R');           // เดินหน้า 30 ซม. -> Swing หน้าขวา 45° (ไม่หยุด)
    FC4(60, 30, 'l');           // เดินหน้า 30 ซม. -> หยุดแล้วหมุน Spin ซ้าย 45°
    FC4(60, 30, 'r');           // เดินหน้า 30 ซม. -> หยุดแล้วหมุน Spin ขวา 45°

    BC4(50, 30, 'L');           // ถอยหลัง 30 ซม. -> Swing หลังซ้าย 45° (ไม่หยุด)
    BC4(50, 30, 'R');           // ถอยหลัง 30 ซม. -> Swing หลังขวา 45° (ไม่หยุด)
    BC4(50, 30, 'l');           // ถอยหลัง 30 ซม. -> หยุดแล้วหมุน Spin ซ้าย 45°
    BC4(50, 30, 'r');           // ถอยหลัง 30 ซม. -> หยุดแล้วหมุน Spin ขวา 45°

    // ------------------------------------------------------------------------
    // 4. คำสั่งหมุนและเลี้ยวแยก (กำหนดองศาอิสระ)
    // ------------------------------------------------------------------------
    SpinDegree(90);             // หมุนขวาอยู่กับที่ 90 องศา (+ ขวา, - ซ้าย)
    SpinDegree(-180);           // หมุนซ้ายกลับตัว 180 องศา

    TrunDegreeFront(90);        // เทิร์นหน้าไปทางขวา 90 องศา (ซ้ายเดินหน้า ขวาหยุด)
    TrunDegreeFront(-90);       // เทิร์นหน้าไปทางซ้าย 90 องศา (ขวาเดินหน้า ซ้ายหยุด)

    TrunDegreeBack(90);         // เทิร์นหลังไปทางขวา 90 องศา (ซ้ายถอยหลัง ขวาหยุด)
    TrunDegreeBack(-90);        // เทิร์นหลังไปทางซ้าย 90 องศา (ขวาถอยหลัง ซ้ายหยุด)

    // ------------------------------------------------------------------------
    // 5. คำสั่งเซอร์โว DropF / DropB และปรับแนวเส้น SetF / SetB
    // ------------------------------------------------------------------------
    DropF();                    // เซอร์โวหน้า (S0) ไป Drop -> หน่วง servoDropDelayMs -> กลับ Lock
    DropB();                    // เซอร์โวหลัง (S1) ไป Drop -> หน่วง servoDropDelayMs -> กลับ Lock

    DropF(30);                  // วิ่งหน้าความเร็ว 30 เข้าเส้น (SetFront_drop) -> DropF()
    DropB(30);                  // ถอยหลังความเร็ว 30 เข้าเส้น (SetBack_drop) -> DropB()

    SetF(25);                   // วิ่งเข้าชนเส้นด้วยเซนเซอร์คู่หน้า (FL, FR) พร้อมรีเซ็ต Yaw
    SetF(25, 10);               // ชนเส้นหน้า -> ถอยออก 10 ซม.
    SetF(25, 10, 'R');          // ชนเส้นหน้า -> ถอยออก 10 ซม. -> หยุดหมุน Spin ขวา 90 องศา ('L'/'R' เฉพาะ Spin)

    SetB(25);                   // ถอยเข้าชนเส้นด้วยเซนเซอร์คู่หลัง (BL, BR) พร้อมรีเซ็ต Yaw
    SetB(25, 10);               // ชนเส้นหลัง -> เดินหน้าออก 10 ซม.
    SetB(25, 10, 'L');          // ชนเส้นหลัง -> เดินหน้าออก 10 ซม. -> หยุดหมุน Spin ซ้าย 90 องศา ('L'/'R' เฉพาะ Spin)

    // ------------------------------------------------------------------------
    // 6. คำสั่งหยุดชั่วคราว STOP() และหน่วงเวลา delay() ของระบบ
    // ------------------------------------------------------------------------
    delay(500);                 // หน่วงเวลา 500ms (ใช้คำสั่งมาตรฐานของระบบ)
    STOP();                     // หยุดรอผู้ใช้กดปุ่ม A หรือ B เพื่อทำคำสั่งบรรทัดถัดไปต่อ
}
