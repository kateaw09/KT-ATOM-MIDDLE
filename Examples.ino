// ============================================================================
// Examples.ino — คู่มือและตัวอย่างการใช้งานคำสั่งทั้งหมด (อ้างอิง PT_MIDDLE_ENC_2026Endcode4MOV1)
// (ฟังก์ชันนี้ไม่ได้ถูกเรียกทำงานจริง ใช้สำหรับดูตัวอย่างและตรวจสอบคอมไพล์ทุก Overload)
// ============================================================================

void examples() {
    // ------------------------------------------------------------------------
    // 1. FFE / BBE (สไตล์ PT_MIDDLE_ENC_2026Endcode4MOV1)
    // ------------------------------------------------------------------------
    FFE(100, 85);                       // เดินหน้า Encoder 85 cm (ไม่หยุดท้ายคำสั่ง)
    FFE(100, 85, 5, 5);                 // กำหนด Ramp Up / Ramp Down เอง (หยุดท้ายคำสั่ง)
    FFE(100, 85, 'R');                  // เดินหน้า -> หมุน Spin ขวา 90°
    FFE(100, 85, 'L');                  // เดินหน้า -> หมุน Spin ซ้าย 90°
    FFE(100, 85, 'r');                  // เดินหน้า -> หมุน Spin ขวา 45°
    FFE(100, 85, 'l');                  // เดินหน้า -> หมุน Spin ซ้าย 45°
    FFE(100, 85, 'R', 5, 5);            // กำหนด Ramp + หมุน Spin ขวา 90°

    BBE(100, 85);                       // ถอยหลัง Encoder 85 cm (ไม่หยุดท้ายคำสั่ง)
    BBE(100, 85, 5, 5);                 // กำหนด Ramp Up / Ramp Down เอง (หยุดท้ายคำสั่ง)
    BBE(100, 85, 'L');                  // ถอยหลัง -> หมุน Spin ซ้าย 90°
    BBE(100, 85, 'R', 5, 5);            // กำหนด Ramp + หมุน Spin ขวา 90°

    // ------------------------------------------------------------------------
    // 2. FFE_turn / BBE_turn — รองรับทั้ง Gyro Turn และ TT Encoder ('TR','TL','Tr','Tl' / "TR","TL","Tr","Tl")
    // ------------------------------------------------------------------------
    FFE_turn(100, 100);
    FFE_turn(100, 100, 'R');            // turnDegreeFront(90)
    FFE_turn(100, 100, 'L');            // turnDegreeFront(-90)
    FFE_turn(100, 100, 'r');            // turnDegreeFront(45)
    FFE_turn(100, 100, 'l');            // turnDegreeFront(-45)
    FFE_turn(100, 100, 'TR');           // TTF90(100, 15, 40) ตีโค้งขวา 90°
    FFE_turn(100, 100, 'TL');           // TTF90(15, 100, 40) ตีโค้งซ้าย 90°
    FFE_turn(100, 100, 'Tr');           // TTF45(80, 15, 30)  ตีโค้งขวา 45°
    FFE_turn(100, 100, 'Tl');           // TTF45(15, 80, 30)  ตีโค้งซ้าย 45°
    FFE_turn(100, 100, "TR");           // แบบ String Literal ก็ใช้ได้เช่นกัน
    FFE_turn(100, 100, "TL");
    FFE_turn(100, 100, "Tr");
    FFE_turn(100, 100, "Tl");
    FFE_turn(100, 100, 5, 5);
    FFE_turn(100, 100, 'TR', 5, 5);
    FFE_turn(100, 100, "TL", 5, 5);

    BBE_turn(100, 100);
    BBE_turn(100, 100, 'R');            // turnDegreeBack(90)
    BBE_turn(100, 100, 'L');            // turnDegreeBack(-90)
    BBE_turn(100, 100, 'r');            // turnDegreeBack(45)
    BBE_turn(100, 100, 'l');            // turnDegreeBack(-45)
    BBE_turn(100, 100, 'TR');           // TTB90(100, 15, 40) ถอยตีโค้งขวา 90°
    BBE_turn(100, 100, 'TL');           // TTB90(15, 100, 40) ถอยตีโค้งซ้าย 90°
    BBE_turn(100, 100, 'Tr');           // TTB45(80, 15, 30)  ถอยตีโค้งขวา 45°
    BBE_turn(100, 100, 'Tl');           // TTB45(15, 80, 30)  ถอยตีโค้งซ้าย 45°
    BBE_turn(100, 100, "TR");
    BBE_turn(100, 100, "TL");
    BBE_turn(100, 100, "Tr");
    BBE_turn(100, 100, "Tl");
    BBE_turn(100, 100, 5, 5);
    BBE_turn(100, 100, 'TL', 5, 5);
    BBE_turn(100, 100, "TR", 5, 5);

    // ------------------------------------------------------------------------
    // 3. FC / BC / FC4 / BC4 (มาตรฐาน KT Middle IDE บนระบบเดินใหม่ + รองรับ TT)
    // ------------------------------------------------------------------------
    FC(60, 30.0f);                      // เดินหน้า 30 cm แล้วหยุด
    FC(60, 30.0f, false);               // เดินหน้า 30 cm ไม่หยุด
    FC(80, 30.0f, 'R');                 // เดินหน้า 30 cm -> turnDegreeFront(90)
    FC(80, 30.0f, 'L');                 // เดินหน้า 30 cm -> turnDegreeFront(-90)
    FC(80, 30.0f, 'r');                 // เดินหน้า 30 cm -> หยุดแล้ว spinDegree(90)
    FC(80, 30.0f, 'l');                 // เดินหน้า 30 cm -> หยุดแล้ว spinDegree(-90)
    FC(100, 30.0f, 'TR');               // เดินหน้า 30 cm -> TTF90(100, 15, 40)
    FC(100, 30.0f, 'TL');               // เดินหน้า 30 cm -> TTF90(15, 100, 40)
    FC(100, 30.0f, 'Tr');               // เดินหน้า 30 cm -> TTF45(80, 15, 30)
    FC(100, 30.0f, 'Tl');               // เดินหน้า 30 cm -> TTF45(15, 80, 30)
    FC(100, 30.0f, "TR");
    FC(100, 30.0f, "TL");
    FC(100, 30.0f, "Tr");
    FC(100, 30.0f, "Tl");

    BC(50, 30.0f);                      // ถอยหลัง 30 cm แล้วหยุด
    BC(60, 30.0f, 'L');                 // ถอยหลัง 30 cm -> turnDegreeBack(-90)
    BC(60, 30.0f, 'l');                 // ถอยหลัง 30 cm -> หยุดแล้ว spinDegree(-90)
    BC(100, 30.0f, 'TR');               // ถอยหลัง 30 cm -> TTB90(100, 15, 40)
    BC(100, 30.0f, 'TL');               // ถอยหลัง 30 cm -> TTB90(15, 100, 40)
    BC(100, 30.0f, 'Tr');               // ถอยหลัง 30 cm -> TTB45(80, 15, 30)
    BC(100, 30.0f, 'Tl');               // ถอยหลัง 30 cm -> TTB45(15, 80, 30)
    BC(100, 30.0f, "TR");
    BC(100, 30.0f, "TL");
    BC(100, 30.0f, "Tr");
    BC(100, 30.0f, "Tl");

    FC4(60, 30.0f, 'R');                // เดินหน้า 30 cm -> turnDegreeFront(45)
    FC4(60, 30.0f, 'l');                // เดินหน้า 30 cm -> หยุดแล้ว spinDegree(-45)
    BC4(50, 20.0f, 'L');                // ถอยหลัง 20 cm -> turnDegreeBack(-45)
    BC4(50, 20.0f, 'r');                // ถอยหลัง 20 cm -> หยุดแล้ว spinDegree(45)

    // ------------------------------------------------------------------------
    // 4. ตีโค้ง Encoder ล้วน (TTF90 / TTF45 / TTB90 / TTB45)
    //    หมายเหตุสำคัญ:
    //    - TTF90(speed_left, speed_right, cm)  เรียง (ซ้าย, ขวา, ระยะ)
    //    - TTB90(speed_right, speed_left, cm)  เรียง (ขวา, ซ้าย, ระยะ) ตาม SpinFunction.ino!
    // ------------------------------------------------------------------------
    TTF90(100, 15, 40);                 // เดินหน้าตีโค้งขวา 90° (ซ้าย=100, ขวา=15, ระยะ=40)
    TTF90(15, 100, 40);                 // เดินหน้าตีโค้งซ้าย 90° (ซ้าย=15, ขวา=100, ระยะ=40)
    TTF45(80, 15, 30);                  // เดินหน้าตีโค้งขวา 45°
    TTF45(15, 80, 30);                  // เดินหน้าตีโค้งซ้าย 45°

    TTB90(100, 15, 40);                 // ถอยหลังตีโค้ง 'TR' (ขวา=100, ซ้าย=15, ระยะ=40 -> หมุน +90°)
    TTB90(15, 100, 40);                 // ถอยหลังตีโค้ง 'TL' (ขวา=15, ซ้าย=100, ระยะ=40 -> หมุน -90°)
    TTB45(80, 15, 30);                  // ถอยหลังตีโค้ง 'Tr' (ขวา=80, ซ้าย=15, ระยะ=30 -> หมุน +45°)
    TTB45(15, 80, 30);                  // ถอยหลังตีโค้ง 'Tl' (ขวา=15, ซ้าย=80, ระยะ=30 -> หมุน -45°)

    // ------------------------------------------------------------------------
    // 5. คำสั่งหมุนและเลี้ยวแยก Gyro (spinDegree / turnDegreeFront / turnDegreeBack)
    // ------------------------------------------------------------------------
    spinDegree(90);
    spinDegree(-90);
    SpinDegree(90.0f);
    SpinDegree(-180.0f);

    turnDegreeFront(90);
    turnDegreeFront(-90);
    TrunDegreeFront(90.0f);

    turnDegreeBack(90);
    turnDegreeBack(-90);
    TrunDegreeBack(-90.0f);

    // ------------------------------------------------------------------------
    // 6. คำสั่งเดินด้วยเวลา (FF / BB / FF_turn / BB_turn)
    // ------------------------------------------------------------------------
    FF(40, 1200);
    FF(50, 500, 150, 200);
    FF(50, 500, 'R');
    FF_turn(80, 500);
    FF_turn(80, 500, 'R');
    FF_turn(80, 500, 'TR');
    FF_turn(80, 500, "TL");

    BB(40, 1000);
    BB(50, 500, 150, 200);
    BB(50, 500, 'L');
    BB_turn(80, 500);
    BB_turn(80, 500, 'L');
    BB_turn(80, 500, 'TL');
    BB_turn(80, 500, "TR");

    // ------------------------------------------------------------------------
    // 7. จัดแนวเข้าเส้น (SetFront / SetBack / SetF / SetB) และปล่อยลูกบาศก์ (DropF / DropB)
    // ------------------------------------------------------------------------
    SetFront(45);
    SetFront(45, 5);
    SetFront(45, 5, 'L');
    SetFront_Yaw(40);
    SetFront_Yaw(40, 10, 'R');
    SetFront_time(40, 150);
    SetFront_time(40, 150, 'R');

    SetBack(45);
    SetBack(45, 5);
    SetBack(45, 5, 'R');
    SetBack_Yaw(40);
    SetBack_Yaw(40, 10, 'L');
    SetBack_time(40, 150);
    SetBack_time(40, 150, 'L');

    SetF(25);
    SetF(25, 10.0f);
    SetF(25, 10.0f, 'R');
    SetB(25);
    SetB(25, 10.0f);
    SetB(25, 10.0f, 'L');

    DropF();
    DropF(40);
    DropB();
    DropB(40);

    // ------------------------------------------------------------------------
    // 8. หยุดชั่วคราว STOP() และ delay()
    // ------------------------------------------------------------------------
    delay(500);
    STOP();
}
