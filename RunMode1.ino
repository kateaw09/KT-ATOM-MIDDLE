// ============================================================================
// RunMode1.ino — ภารกิจโหมดที่ 1 (สร้างและซิงค์จาก Field Solver)
// ============================================================================

extern int speed;

void runMode1() {
    Box1();
    Box2();
    Box3();
    Box4();
    EndMission();
}

void Box1() {
    FC(65, 23.7f, 'R');
    FC(65, 47.4f, 'R');
    FC(65, 17.4f, 'R');
    FC(42, 17.4f, 'L');
    FC(42, 17.4f, 'R');
    FC(42, 23.7f);
    FC(65, 30.0f);
    FC(42, 60.0f);
    FC(65, 23.7f, 'R');
    FC(65, 17.4f, 'R');
    FC(42, 47.4f, 'L');
    FC(65, 47.4f, 'R');
    FC(65, 23.7f);
    FC(42, 60.0f);
    DropF();  // แท่นทิ้งลูกบาศก์สีน้ำเงิน 50mm (R0, C5)
    BC(42, 60.0f);
    BC(65, 30.0f);
    BC(42, 60.0f);
    DropF();  // แท่นทิ้งลูกบาศก์สีเหลือง 50mm (R0, C0)
}

void Box2() {
    FC(42, 53.7f, 'R');
    FC(65, 47.4f, 'R');
    FC(42, 47.4f, 'L');
    FC(65, 17.4f, 'L');
    FC(65, 23.7f);
    FC(42, 53.7f, 'L');
    FC(65, 23.7f);
}

void Box3() {
    BC(65, 23.7f, 'L');
    BC(65, 23.7f);
    BC(42, 23.7f, 'L');
    BC(42, 17.4f, 'R');
    BC(42, 17.4f, 'L');
    BC(65, 53.7f);
    DropF(30);  // ทิ้งลูกบาศก์สีเขียว พื้น 5mm (R0, C6)
    BC(30, 12.0f);
}

void Box4() {
    FC(65, 53.7f, 'L');
    FC(65, 17.4f, 'R');
    FC(65, 17.4f, 'R');
    FC(65, 23.7f);
    DropF(30);  // ทิ้งลูกบาศก์สีเขียว พื้น 5mm (R3, C6)
    BC(30, 12.0f);
}

void EndMission() {
    BC(65, 23.7f, 'L');
    BC(65, 83.7f);
    STOP();  // FINISH เส้นชัย (R0, C7)
}
