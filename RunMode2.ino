extern int speed;

void runMode2() {
    M2_Box1();
    M2_Box2();
    M2_Box3();
    M2_Box4();
    M2_EndMission();
}

void M2_Box1() {
    FC(42, 30.0f, 'R');
    FC(42, 30.0f, 'L');
    FC(65, 60.0f, 'R');
    FC(65, 30.0f);
    FC(42, 30.0f);
    DropF(30);  // แท่นทิ้งลูกบาศก์สีน้ำเงิน 50mm (R0, C5)
    BC(42, 30.0f, 'L');
    TrunDegreeFront(-90.0f);
    FC(65, 30.0f);
    FC(42, 30.0f);
    DropF(30);  // แท่นทิ้งลูกบาศก์สีแดง 50mm (R0, C0)
    BC(42, 30.0f, 'L');
    FC(65, 60.0f, 'R');
    FC(42, 30.0f, 'L');
    FC(42, 30.0f);
    TrunDegreeFront(-90.0f);
    FC(42, 60.0f, 'L');
    FC(65, 30.0f);
    BC(65, 30.0f, 'R');
    FC(65, 30.0f);
    FC(42, 30.0f, 'L');
    FC(42, 30.0f, 'R');
    FC(42, 30.0f);
    FC(65, 30.0f, 'R');
    FC(65, 30.0f, 'R');
    FC(65, 30.0f);
    DropF(30);  // ทิ้งลูกบาศก์สีเหลือง พื้น 5mm (R3, C6)
    BC(65, 30.0f, 'R');
    FC(65, 90.0f, 'L');
    FC(65, 30.0f);
    DropF(30);  // ทิ้งลูกบาศก์สีแดง พื้น 5mm (R0, C6)
    BC(65, 30.0f);
    STOP();  // FINISH เส้นชัย (R0, C7)
}

